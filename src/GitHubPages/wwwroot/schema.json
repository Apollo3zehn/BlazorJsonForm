{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Rocket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "MissionDataPath"
  ],
  "properties": {
    "EngineCount": {
      "type": "integer",
      "description": "Number of engines @ int (0 <= value <= 10)",
      "format": "int32",
      "maximum": 10.0,
      "minimum": 0.0,
      "x-label": "EngineCount_label"
    },
    "HeadlightBrightness": {
      "type": "integer",
      "description": "Headlight brightness @ byte",
      "format": "byte",
      "x-label": "HeadlightBrightness_label"
    },
    "ImprobabilityDriveFlux": {
      "type": "integer",
      "description": "Flux of the improbability drive @ long",
      "format": "int64",
      "x-label": "ImprobabilityDriveFlux_label"
    },
    "Storage": {
      "type": "integer",
      "description": "Data recording storage size in bytes @ ulong",
      "format": "uint64",
      "x-label": "Storage_label"
    },
    "AmbientTemperature": {
      "type": "number",
      "description": "Ambient temperature in °C @ float",
      "format": "float",
      "x-label": "AmbientTemperature_label"
    },
    "Fuel": {
      "type": "number",
      "description": "Amount of fuel in L @ double",
      "format": "double",
      "x-label": "Fuel_label"
    },
    "EnableTelemetry": {
      "type": "boolean",
      "description": "Enable telemetry @ bool",
      "x-label": "EnableTelemetry_label"
    },
    "FlightStart": {
      "type": [
        "null",
        "string"
      ],
      "description": "Flight start @ DateTime",
      "format": "date-time",
      "x-label": "FlightStart_label"
    },
    "FlightDuration": {
      "type": "string",
      "description": "Flight duration @ TimeSpan",
      "format": "duration",
      "x-label": "FlightDuration_label"
    },
    "Message": {
      "type": "string",
      "description": "Message from mankind @ string (max length)",
      "maxLength": 20,
      "minLength": 0,
      "x-label": "Message_label"
    },
    "MissionDataPath": {
      "type": "string",
      "description": "Mission data path @ string (regex)",
      "minLength": 1,
      "pattern": "^(?:\\/[a-zA-Z_][a-zA-Z_0-9]*)+$",
      "x-label": "MissionDataPath_label",
      "x-helperText": "Example: /path/to/mission/data"
    },
    "Status": {
      "description": "Rocket status @ enum of ushort",
      "oneOf": [
        {
          "$ref": "#/definitions/RocketStatus"
        }
      ],
      "x-label": "Status_label"
    },
    "MissionTargets": {
      "description": "Mission targets @ flags",
      "oneOf": [
        {
          "$ref": "#/definitions/MissionTargets"
        }
      ],
      "x-label": "MissionTargets_label"
    },
    "MainPayload": {
      "description": "Main payload @ object",
      "oneOf": [
        {
          "$ref": "#/definitions/Payload"
        }
      ],
      "x-label": "MainPayload_label"
    },
    "AdditionalPayloads": {
      "type": "array",
      "description": "Additional payloads @ array of objects",
      "items": {
        "$ref": "#/definitions/Payload"
      },
      "x-label": "AdditionalPayloads_label"
    },
    "LaunchCoordinates": {
      "type": "array",
      "description": "Launch coordinates @ array of ints",
      "items": {
        "type": "integer",
        "format": "int32"
      },
      "x-label": "LaunchCoordinates_label"
    },
    "BabelFishDictionary": {
      "type": "object",
      "description": "Babelfish dictionary @ dict of string and string",
      "additionalProperties": {
        "type": "string"
      },
      "x-label": "BabelFishDictionary_label",
      "x-keyLabel": "Vogon",
      "x-valueLabel": "English"
    }
  },
  "definitions": {
    "RocketStatus": {
      "type": "integer",
      "description": "",
      "x-enumNames": [
        "Ready",
        "Ignition",
        "Flight"
      ],
      "enum": [
        0,
        1,
        2
      ]
    },
    "MissionTargets": {
      "type": "integer",
      "description": "",
      "x-enumFlags": true,
      "x-enumNames": [
        "Mercury",
        "Venus",
        "Mars",
        "Jupiter",
        "Saturn",
        "Uranus",
        "Neptune"
      ],
      "enum": [
        1,
        2,
        4,
        8,
        16,
        32,
        64
      ],
      "x-enumDisplayNames": [
        "The Mercury",
        "The Venus",
        "The Mars",
        "The Jupiter",
        "The Saturn",
        "The Uranus",
        "The Neptune"
      ]
    },
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": {
          "type": "string",
          "description": "Name",
          "x-label": "Name_label"
        },
        "Weight": {
          "type": "number",
          "description": "Weight in kg",
          "format": "double",
          "x-label": "Weight_label"
        }
      }
    }
  }
}